# Root-level env file for `docker compose`'s own ${VAR} substitution in
# docker-compose.prod.yml - separate from backend/.env, which is the app's own config
# (see backend/.env.example for that one). Copy this to `.env` on the server and fill in
# real values. Never commit the real file - it's already gitignored.

# Real domains you control DNS for (or free subdomains - e.g. DuckDNS), pointed at the
# server's IP via an A record before starting caddy, so it can obtain TLS certificates.
API_DOMAIN=api.example.com
STORAGE_DOMAIN=storage.example.com
# The frontend's real origin (e.g. your Vercel deployment URL, or a custom domain pointed
# at it) - used only for MinIO's CORS allow-list, not served from this machine.
FRONTEND_DOMAIN=your-app.vercel.app

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=

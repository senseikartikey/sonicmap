DATABASE_URL=postgresql+psycopg://sonicmap:sonicmap@localhost:5432/sonicmap
ITUNES_SEARCH_BASE_URL=https://itunes.apple.com/search

# From https://developer.spotify.com/dashboard -> Create app.
# Add SPOTIFY_REDIRECT_URI as a Redirect URI on the app itself too.
# Must be 127.0.0.1, not localhost - Spotify rejects the "localhost" hostname as of their
# Nov 2025 OAuth migration and only accepts the literal loopback IP for HTTP redirect URIs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Any random long string in dev; use a real secret in prod.
JWT_SECRET=dev-only-change-me
APP_ENVIRONMENT=development
MAGIC_LINK_ENABLED=false
RATE_LIMIT_ENABLED=true

# Also 127.0.0.1, not localhost - must match what you type into the browser so the session
# token (stored in localStorage, which is origin-scoped) survives the OAuth redirect.
FRONTEND_BASE_URL=http://127.0.0.1:3001

# Stem Studio uses any private S3-compatible object store. These defaults match the MinIO
# service in docker-compose.yml. Set the public endpoint to the URL browsers can reach.
STEM_STUDIO_ENABLED=true
STEM_YOUTUBE_ENABLED=false
STEM_S3_ENDPOINT_URL=http://localhost:9000
STEM_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
STEM_S3_REGION=us-east-1
STEM_S3_ACCESS_KEY=sonicmap
STEM_S3_SECRET_KEY=sonicmap-dev-secret
STEM_S3_BUCKET=sonicmap-stems
STEM_RETENTION_HOURS=24
STEM_DAILY_JOB_LIMIT=3
STEM_MAX_ACTIVE_JOBS=1
